#[test_only]
module m2m::signing_tests;

// Generated from fixtures/signing-vectors.json. Public test keys have no funds.
#[test]
fun endpoint_signatures_verify_in_move() {
    let quote = x"";
    let quote_sig = x"c1d30a4b7afbb3a3bbaa34451c8940307f9b00609d0de6c1296cd08151b235063447f481be59ce96dd084681e51e00cbd9403394aa3e4330b078c7f3afcff002";
    let provider = x"8139770ea87d175f56a35466c34c7ecccb8d8a91b4ee37a25df60f5b8fc9b394";
    let receipt = x"";
    let receipt_sig = x"052d10b03b4fa37012b2e3dc658e5de30f0f48379306edb2a9a3fa41e9e881e5ea0023963ec9674db7336a392f70306026a2ac3c3368e6932b9a9e63cf6d230d";
    let buyer = x"8a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c";
    assert!(sui::ed25519::ed25519_verify(&quote_sig, &provider, &quote));
    assert!(sui::ed25519::ed25519_verify(&receipt_sig, &buyer, &receipt));
    assert!(!sui::ed25519::ed25519_verify(&quote_sig, &buyer, &quote));
    assert!(!sui::ed25519::ed25519_verify(&receipt_sig, &buyer, &quote));
    assert!(sui::hash::blake2b256(&quote) == x"c4b007b4243b06648f5e10e78f59e87d3889b51d6b05f72d081964af91283202");
}
