# Deny unknown files, operator state and credentials before sending the context.
**
!Cargo.toml
!Cargo.lock
!src/
!src/**/*.rs
!fixtures/
!fixtures/hello.txt
!package.json
!package-lock.json
!scripts/
!scripts/agent-*.ts
!scripts/reduced-demo-*.ts
!scripts/reduced-live-demo.ts
!scripts/responses-*.ts
!scripts/native-*.ts
!scripts/streaming-*.ts
!scripts/codex-worker.ts
!scripts/research-conversation.ts
!scripts/demo-types.ts
!scripts/chain.ts
!scripts/codec.ts
scripts/*-examples.ts
!deploy/
!deploy/agent-demo/
!deploy/agent-demo/Dockerfile
!deploy/agent-demo/Dockerfile.dockerignore
!deploy/agent-demo/build.mjs
!ui/
!ui/agent-demo/
!ui/agent-demo/package.json
!ui/agent-demo/package-lock.json
!ui/agent-demo/index.html
!ui/agent-demo/tsconfig.json
!ui/agent-demo/vite.config.ts
!ui/agent-demo/src/
!ui/agent-demo/src/**/*.ts
!ui/agent-demo/src/**/*.tsx
!ui/agent-demo/src/**/*.css
